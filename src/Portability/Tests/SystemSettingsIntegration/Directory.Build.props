<Project>
  <Import Project="../../Directory.Build.props" />
  <PropertyGroup>
    <PortabilityRepositoryRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '../../../../'))</PortabilityRepositoryRoot>
    <SystemSettingsProjectDirectory>$([System.IO.Path]::GetFileName('$(MSBuildProjectDirectory)'))</SystemSettingsProjectDirectory>
    <BaseOutputPath>$(PortabilityRepositoryRoot)artifacts/portability/system-settings-integration/bin/$(OS)/$(SystemSettingsProjectDirectory)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(PortabilityRepositoryRoot)artifacts/portability/system-settings-integration/obj/$(OS)/$(SystemSettingsProjectDirectory)/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>
</Project>
