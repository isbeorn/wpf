<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Exe</OutputType>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Program.cs" Link="Program.cs" />
    <Compile Include="../CombineCases.cs" Link="CombineCases.cs" />
    <Compile Include="../OutlineCases.cs" Link="OutlineCases.cs" />
    <Compile Include="../BoundsCases.cs" Link="BoundsCases.cs" />
    <Compile Include="../CrosshairBoundsCases.cs" Link="CrosshairBoundsCases.cs" />
    <Compile Include="../DashedBoundsCases.cs" Link="DashedBoundsCases.cs" />
    <Compile Include="../GridBoundsCases.cs" Link="GridBoundsCases.cs" />
    <None Include="../GridDrawingSnapshot.json;../GridBoundsReference.json;../GridAffineReference.json" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../MixedStrokeCases.cs" Link="MixedStrokeCases.cs" />
    <None Include="../BoundsPrecisionReference.json" Link="BoundsPrecisionReference.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../DashedBoundsReference.json" Link="DashedBoundsReference.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
