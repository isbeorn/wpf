<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(AstronomyProfile)' == 'stock'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(AstronomyProfile)' != 'stock'">net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="NighttimeProgram.cs" />
    <Reference Include="$(OriginalManagedDirectory)/*.dll" Condition="'$(AstronomyProfile)' == 'stock'" Private="true" />
    <Reference Include="$(OriginalManagedDirectory)/*.dll" Exclude="$(OriginalManagedDirectory)/NINA.Core.dll;$(OriginalManagedDirectory)/NINA.Astrometry.dll" Condition="'$(AstronomyProfile)' != 'stock'" Private="true" />
    <Reference Include="$(NinaCorePath);$(NinaAstrometryPath);$(FrameworkRuntimeDirectory)/*.dll" Condition="'$(AstronomyProfile)' != 'stock'" Private="true" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" Condition="'$(AstronomyProfile)' == 'stock'" />
    <Content Include="$(EphemerisPath)" Link="External/JPLEPH" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(SofaLibraryPath)" Link="External/x64/SOFA/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(NovasLibraryPath)" Link="External/x64/NOVAS/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(SqliteLibraryPath)" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(DatabaseSourceDirectory)/**/*.sql" Link="Database/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
