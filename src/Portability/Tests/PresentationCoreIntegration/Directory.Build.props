<Project>
  <Import Project="../../Directory.Build.props" />
  <PropertyGroup>
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '../../../..'))</RepoRoot>
    <BaseOutputPath>$(RepoRoot)artifacts/portability/presentationcore-integration/bin/$(OS)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(RepoRoot)artifacts/portability/presentationcore-integration/obj/$(OS)/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>
</Project>
