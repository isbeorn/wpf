<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>System.Private.Windows.Core</AssemblyName>
    <RootNamespace />
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>$(BaseIntermediateOutputPath)Ecma.public.snk</AssemblyOriginatorKeyFile>
    <NoWarn>$(NoWarn);CS8981;SYSLIB5005</NoWarn>
    <WindowsCoreSourceRoot>$(RepoRoot)artifacts/portability/windows-core-source/upstream/</WindowsCoreSourceRoot>
    <WindowsCoreArchive>$(RepoRoot)artifacts/portability/windows-core-source/winforms-3c92f9f1cc1dcc74779795d518c67aa80f472df7.zip</WindowsCoreArchive>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="[0.3.151]" PrivateAssets="all" />
    <PackageReference Include="System.Formats.Nrbf" Version="10.0.13" />
    <AdditionalFiles Include="$(WindowsCoreSourceRoot)NativeMethods.txt;$(WindowsCoreSourceRoot)NativeMethods.json" />
    <EmbeddedResource Include="$(WindowsCoreSourceRoot)Resources/SR.resx">
      <WithCulture>false</WithCulture>
      <ManifestResourceName>System.Private.Windows.Core.Resources.SR</ManifestResourceName>
      <StronglyTypedLanguage>C#</StronglyTypedLanguage>
      <StronglyTypedNamespace>System.Private.Windows.Core.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>SR</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)SR.Designer.cs</StronglyTypedFileName>
    </EmbeddedResource>
  </ItemGroup>
  <Import Project="Source.targets" />
</Project>
