<Project>
  <ItemGroup>
    <PackageReference Include="System.CodeDom" Version="[10.0.13]" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="[10.0.13]" />
  </ItemGroup>
  <Target Name="IncludePortableCompilerDependencies" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Condition="'%(Reference.Identity)' == 'System.CodeDom' or '%(Reference.Identity)' == 'System.Reflection.MetadataLoadContext'">
        <HintPath>$([MSBuild]::NormalizePath('$(NuGetPackageRoot)', '$([System.String]::Copy('%(Reference.Identity)').ToLowerInvariant())', '10.0.13', 'lib', 'net10.0', '%(Reference.Identity).dll'))</HintPath>
        <Private>true</Private>
      </Reference>
    </ItemGroup>
  </Target>
</Project>
