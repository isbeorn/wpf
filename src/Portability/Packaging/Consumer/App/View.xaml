<UserControl x:Class="PackageConsumer.View"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="clr-namespace:PackageCompanion;assembly=Companion" OverridesDefaultStyle="True">
 <UserControl.Template>
  <ControlTemplate TargetType="UserControl"><ContentPresenter Content="{TemplateBinding Content}" /></ControlTemplate>
 </UserControl.Template>
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Companion;component/Dictionary.xaml" />
   </ResourceDictionary.MergedDictionaries>
   <c:ValueSource x:Key="Source" Value="9" />
  </ResourceDictionary>
 </UserControl.Resources>
 <StackPanel Background="{StaticResource CompanionBrush}">
  <Button x:Name="ActionButton" Content="Go" Width="180" Height="60" HorizontalAlignment="Left"
          OverridesDefaultStyle="True" Click="OnClick" Background="Green">
   <Button.Template>
    <ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" /></ControlTemplate>
   </Button.Template>
  </Button>
  <TextBox x:Name="Editor" Width="220" Height="60" HorizontalAlignment="Left" FontSize="18"
           OverridesDefaultStyle="True" Background="White">
   <TextBox.Template>
    <ControlTemplate TargetType="TextBox">
     <ScrollViewer x:Name="PART_ContentHost" OverridesDefaultStyle="True" Background="{TemplateBinding Background}">
      <ScrollViewer.Template>
       <ControlTemplate TargetType="ScrollViewer">
        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" />
       </ControlTemplate>
      </ScrollViewer.Template>
     </ScrollViewer>
    </ControlTemplate>
   </TextBox.Template>
  </TextBox>
  <Border x:Name="Bound" Width="{Binding Value, Source={StaticResource Source}}" Height="5" />
 </StackPanel>
</UserControl>
