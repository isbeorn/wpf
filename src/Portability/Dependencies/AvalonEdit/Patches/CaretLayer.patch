+#if PORTABLE_AVALONEDIT
+		static TimeSpan ReadPortableStartupCaretBlinkTime()
+		{
+			const string contract = "Portable AvalonEdit requires the Core startup-profile caret timing contract.";
+			const System.Reflection.BindingFlags flags = System.Reflection.BindingFlags.NonPublic;
+			var provider = typeof(Visual).Assembly.GetType("MS.Internal.Portability.Settings.PortableSystemSettingsProvider");
+			var current = provider?.GetProperty("Current", flags | System.Reflection.BindingFlags.Static);
+			object profile = current?.GetValue(null, null);
+			var timing = profile?.GetType().GetProperty("CaretBlinkTimeMilliseconds", flags | System.Reflection.BindingFlags.Instance);
+			object value = timing?.GetValue(profile, null);
+			if (!(value is int milliseconds) || milliseconds < -1 || milliseconds > int.MaxValue / 2)
+				throw new PlatformNotSupportedException(contract);
+			return TimeSpan.FromMilliseconds(milliseconds);
+		}
+#endif
 
