<Project>
  <Import Project="../../Directory.Build.props" />
  <PropertyGroup>
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '../../../..'))</RepoRoot>
    <AvalonEditArtifactsDir Condition="'$(AvalonEditArtifactsDir)' == ''">$(RepoRoot)artifacts/portability/avalonedit/</AvalonEditArtifactsDir>
    <BaseOutputPath>$(AvalonEditArtifactsDir)bin/$(OS)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(AvalonEditArtifactsDir)obj/$(OS)/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
</Project>
