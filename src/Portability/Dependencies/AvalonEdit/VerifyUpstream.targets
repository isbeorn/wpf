<Project>
  <UsingTask TaskName="VerifyAvalonEditUpstream" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Manifest ParameterType="System.String" Required="true" />
      <OriginalDirectory ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Security.Cryptography" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var json = File.ReadAllText(Manifest);
        var records = System.Text.RegularExpressions.Regex.Matches(json,
            "\"path\"\\s*:\\s*\"([^\"]+)\"[\\s\\S]*?\"sha256\"\\s*:\\s*\"([A-F0-9]+)\"");
        if (records.Count != 254) throw new InvalidDataException("The complete pinned AvalonEdit closure must contain 254 files.");
        if (Directory.GetFiles(OriginalDirectory, "*", SearchOption.AllDirectories).Length != records.Count)
            throw new InvalidDataException("Unexpected file in the pinned AvalonEdit closure.");
        foreach (System.Text.RegularExpressions.Match record in records)
        {
            var path = Path.Combine(OriginalDirectory, record.Groups[1].Value);
            using (var hash = SHA256.Create())
            using (var stream = File.OpenRead(path))
            {
                var actual = BitConverter.ToString(hash.ComputeHash(stream)).Replace("-", "");
                if (actual != record.Groups[2].Value) throw new InvalidDataException("Pinned AvalonEdit input changed: " + path);
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="VerifyPinnedAvalonEditInputs" BeforeTargets="MarkupCompilePass1;CoreCompile">
    <VerifyAvalonEditUpstream Manifest="$(MSBuildThisFileDirectory)upstream.json" OriginalDirectory="$(MSBuildThisFileDirectory)Original" />
  </Target>
</Project>
