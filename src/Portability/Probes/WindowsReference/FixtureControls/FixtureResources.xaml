<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:FixtureControls">
  <SolidColorBrush x:Key="FixtureAccent" Color="#FF1177BB" />
  <Style TargetType="{x:Type local:MetricControl}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:MetricControl}">
          <TextBlock x:Name="PART_Value" Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}}"
                     Foreground="{DynamicResource FixtureAccent}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
